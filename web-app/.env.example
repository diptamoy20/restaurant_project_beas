# Copy to .env and edit for your environment.
# This is the only env file used by the web-app (dev server and production build).

# API + socket — socket URLs are optional if VITE_API_BASE_URL is set
# (socket origin is derived by stripping /api and appending /delivery-tracking).
VITE_API_BASE_URL="http://localhost:4000/api"
VITE_SOCKET_URL="http://localhost:4000"
VITE_TRACKING_SOCKET_URL="http://localhost:4000/delivery-tracking"

VITE_APP_NAME="Restaurant Web App"
VITE_RAZORPAY_KEY_ID="rzp_test_SmSTwiKHdNaqc8"
VITE_ROUTING_BASE_URL="https://router.project-osrm.org"

# Optional. Leave empty for local testing with the free OpenStreetMap fallback.
VITE_GOOGLE_MAPS_API_KEY=""

# Set to true to log socket URL and connection details in the browser console.
VITE_DEBUG_SOCKET=false

VITE_FIREBASE_API_KEY="AIzaSyAyY8-h2Qk8qqmxM_O4FJyI7-DBW8BinxM"
VITE_FIREBASE_AUTH_DOMAIN="restaurant-app-7c31b.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="restaurant-app-7c31b"
VITE_FIREBASE_APP_ID="1:720080454964:web:c80c311a83233dddbe1161"
