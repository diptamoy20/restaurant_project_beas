VITE_API_BASE_URL="http://localhost:4000/api"

# Local development only (.env.development). Do NOT put localhost socket URLs in .env —
# they get baked into production builds if deploy does not override them.
# VITE_SOCKET_URL="http://localhost:4000"

# Production socket (used by `vite build` via .env.production and deploy script):
# VITE_API_BASE_URL="http://182.73.216.93:7005/api"
# VITE_SOCKET_URL="http://182.73.216.93:7005"
# VITE_TRACKING_SOCKET_URL="http://182.73.216.93:7005/delivery-tracking"

# GitHub deploy vars:
#   PUBLIC_API_BASE_URL — REST API URL (may be proxied, e.g. :7001/api)
#   PUBLIC_SOCKET_URL   — optional explicit socket origin (e.g. http://182.73.216.93:7005)
# Deploy also uses backend.env PORT + PUBLIC_API_URL when PUBLIC_SOCKET_URL is unset.

VITE_ROUTING_BASE_URL="https://router.project-osrm.org"
VITE_APP_NAME="Restaurant Web App"
VITE_RAZORPAY_KEY_ID="rzp_test_SmSTwiKHdNaqc8"

# Optional. Leave empty for local testing with the free OpenStreetMap fallback.
# Add a Google Maps Platform browser key for production address search/map picker.
VITE_GOOGLE_MAPS_API_KEY=""

