generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int                    @id @default(autoincrement())
  name                      String?
  email                     String?                @unique
  phone                     String?                @unique
  password                  String
  isActive                  Boolean                @default(true) @map("is_active")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")
  failed_login_attempts     Int                    @default(0)
  last_login_at             DateTime?
  lock_until                DateTime?
  refresh_token             String?
  refresh_token_expires_at  DateTime?
  reset_password_token      String?
  reset_password_expires_at DateTime?
  profile_image_url         String?
  permissions               Json?
  profile_image_public_id   String?
  restaurant_id             Int?
  cart_items                cart_items[]
  coupon_usages             coupon_usages[]
  delivery_agents           delivery_agents?
  device_tokens             device_tokens[]
  favorite_menu_items       favorite_menu_items[]
  loyalty_transactions      loyalty_transactions[]
  memberships               memberships[]
  notifications             notifications[]
  orders                    orders[]
  payments                  payments[]
  social_accounts           social_accounts[]
  user_addresses            user_addresses[]
  user_role                 user_role?
  restaurants               restaurants?           @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("users")
}

model Category {
  id            Int          @id @default(autoincrement())
  restaurant_id Int
  name          String
  description   String?
  restaurants   restaurants  @relation(fields: [restaurant_id], references: [id])
  menu_items    menu_items[]

  @@map("categories")
}

model addon_groups {
  id             Int             @id @default(autoincrement())
  menu_item_id   Int
  restaurant_id  Int
  name           String
  selection_type String          @default("MULTI")
  is_required    Boolean         @default(false)
  min_select     Int?
  max_select     Int?
  sort_order     Int             @default(0)
  is_active      Boolean         @default(true)
  menu_items     menu_items      @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  restaurants    restaurants     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  addon_options  addon_options[]

  @@index([menu_item_id])
  @@index([restaurant_id])
}

model addon_options {
  id                Int                 @id @default(autoincrement())
  group_id          Int
  name              String
  price             Float
  is_available      Boolean             @default(true)
  sort_order        Int                 @default(0)
  addon_groups      addon_groups        @relation(fields: [group_id], references: [id], onDelete: Cascade)
  order_item_addons order_item_addons[]

  @@index([group_id])
}

model cart_items {
  id                 Int                 @id @default(autoincrement())
  user_id            Int
  menu_item_id       Int
  variant_id         Int?
  quantity           Int
  price              Float
  created_at         DateTime            @default(now())
  updated_at         DateTime
  addons             Json?
  restaurant_id      Int?
  menu_items         menu_items          @relation(fields: [menu_item_id], references: [id])
  restaurants        restaurants?        @relation(fields: [restaurant_id], references: [id])
  users              User                @relation(fields: [user_id], references: [id])
  menu_item_variants menu_item_variants? @relation(fields: [variant_id], references: [id])

  @@unique([user_id, menu_item_id, variant_id])
}

model coupon_usages {
  id              Int      @id @default(autoincrement())
  coupon_id       Int
  user_id         Int
  order_id        Int
  discount_amount Float    @default(0)
  created_at      DateTime @default(now())
  coupons         coupons  @relation(fields: [coupon_id], references: [id])
  orders          orders   @relation(fields: [order_id], references: [id])
  users           User     @relation(fields: [user_id], references: [id])

  @@unique([coupon_id, order_id])
  @@index([coupon_id])
  @@index([user_id])
}

model coupons {
  id                   Int             @id @default(autoincrement())
  code                 String          @unique(map: "coupons_global_code_key", where: raw("(restaurant_id IS NULL)"))
  discount_type        String
  discount_value       Float
  min_order_amount     Float?
  expiry_date          DateTime?
  updated_at           DateTime
  restaurant_id        Int?
  description          String?
  max_discount_amount  Float?
  starts_at            DateTime?
  usage_limit_total    Int?
  usage_limit_per_user Int?
  is_active            Boolean         @default(true)
  created_at           DateTime        @default(now())
  coupon_usages        coupon_usages[]
  restaurants          restaurants?    @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([code, restaurant_id], map: "coupons_restaurant_code_key", where: raw("(restaurant_id IS NOT NULL)"))
  @@index([code, restaurant_id])
  @@index([is_active])
  @@index([restaurant_id])
}

model deliveries {
  id                Int                 @id @default(autoincrement())
  order_id          Int                 @unique
  agent_id          Int?
  status            String
  delivery_agents   delivery_agents?    @relation(fields: [agent_id], references: [id])
  orders            orders              @relation(fields: [order_id], references: [id])
  delivery_tracking delivery_tracking[]
}

model delivery_agents {
  id                Int          @id @default(autoincrement())
  name              String
  phone             String
  is_available      Boolean      @default(true)
  user_id           Int?         @unique
  is_verified       Boolean      @default(false)
  address           String?
  date_of_birth     DateTime?    @db.Date
  gender            String?
  emergency_contact String?
  vehicle_type      String?
  vehicle_number    String?
  vehicle_brand     String?
  vehicle_color     String?
  deliveries        deliveries[]
  users             User?        @relation(fields: [user_id], references: [id])

  @@index([phone])
}

model delivery_tracking {
  id          Int        @id @default(autoincrement())
  delivery_id Int
  latitude    Float
  longitude   Float
  speed       Float?
  heading     Float?
  recorded_at DateTime   @default(now())
  deliveries  deliveries @relation(fields: [delivery_id], references: [id])
}

model delivery_zones {
  id                   Int                     @id @default(autoincrement())
  restaurant_id        Int
  polygon              Unsupported("geometry")
  minimum_order_amount Float                   @default(0)
  delivery_fee         Float                   @default(0)
  created_at           DateTime                @default(now())
  updated_at           DateTime
  restaurants          restaurants             @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
}

model device_tokens {
  id           Int      @id @default(autoincrement())
  user_id      Int
  token        String   @unique
  platform     String?
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime
  users        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model favorite_menu_items {
  id           Int        @id @default(autoincrement())
  user_id      Int
  menu_item_id Int
  created_at   DateTime   @default(now())
  menu_items   menu_items @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  users        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, menu_item_id])
  @@index([menu_item_id])
  @@index([user_id])
}

model invoices {
  id             Int       @id @default(autoincrement())
  order_id       Int       @unique
  invoice_number String    @unique
  status         String    @default("LOCKED")
  issued_at      DateTime?
  paid_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime
  orders         orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([status])
}

model loyalty_transactions {
  id       Int    @id @default(autoincrement())
  user_id  Int
  points   Int
  type     String
  order_id Int?
  users    User   @relation(fields: [user_id], references: [id])
}

model membership_tiers {
  id          Int           @id @default(autoincrement())
  name        String
  features    String?
  memberships memberships[]
}

model memberships {
  id               Int              @id @default(autoincrement())
  user_id          Int
  tier_id          Int
  points           Int              @default(0)
  membership_tiers membership_tiers @relation(fields: [tier_id], references: [id])
  users            User             @relation(fields: [user_id], references: [id])
}

model menu_item_variants {
  id           Int           @id @default(autoincrement())
  menu_item_id Int
  name         String
  price        Float
  cart_items   cart_items[]
  menu_items   menu_items    @relation(fields: [menu_item_id], references: [id])
  order_items  order_items[]
}

model menu_items {
  id                   Int                   @id @default(autoincrement())
  restaurant_id        Int
  category_id          Int
  name                 String
  description          String?
  price                Float
  is_available         Boolean               @default(true)
  preparation_time     Int?
  discount_price       Float?
  image_url            String?
  food_type            String                @default("VEG")
  spicy_level          Int?
  ingredients          String?
  is_best_selling      Boolean               @default(false)
  popularity_score     Int                   @default(0)
  rating               Float?
  customizable_options Json?
  image_public_id      String?
  addon_groups         addon_groups[]
  cart_items           cart_items[]
  favorite_menu_items  favorite_menu_items[]
  menu_item_variants   menu_item_variants[]
  categories           Category              @relation(fields: [category_id], references: [id])
  restaurants          restaurants           @relation(fields: [restaurant_id], references: [id])
  order_items          order_items[]
}

model notifications {
  id      Int     @id @default(autoincrement())
  user_id Int
  title   String
  message String
  is_read Boolean @default(false)
  users   User    @relation(fields: [user_id], references: [id])
}

model order_item_addons {
  id                 Int            @id @default(autoincrement())
  order_item_id      Int
  addon_group_id     Int?
  addon_option_id    Int?
  addon_group_name   String
  addon_option_name  String
  addon_option_price Float
  quantity           Int            @default(1)
  addon_options      addon_options? @relation(fields: [addon_option_id], references: [id])
  order_items        order_items    @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@index([addon_option_id])
  @@index([order_item_id])
}

model order_items {
  id                 Int                 @id @default(autoincrement())
  order_id           Int
  menu_item_id       Int
  variant_id         Int?
  quantity           Int
  price              Float
  total_price        Float
  order_item_addons  order_item_addons[]
  menu_items         menu_items          @relation(fields: [menu_item_id], references: [id])
  orders             orders              @relation(fields: [order_id], references: [id])
  menu_item_variants menu_item_variants? @relation(fields: [variant_id], references: [id])

  @@index([menu_item_id])
  @@index([order_id, menu_item_id])
}

model order_status_logs {
  id                 Int      @id @default(autoincrement())
  order_id           Int
  status             String
  changed_at         DateTime @default(now())
  note               String?
  changed_by_user_id Int?
  orders             orders   @relation(fields: [order_id], references: [id])
}

model orders {
  id                     Int                 @id @default(autoincrement())
  user_id                Int?
  restaurant_id          Int
  table_id               Int?
  address_id             Int?
  order_number           String              @unique
  status                 String
  order_type             String
  total_amount           Float
  discount_amount        Float?
  final_amount           Float
  payment_status         String
  created_at             DateTime            @default(now())
  payment_method         String?
  razorpay_order_id      String?
  razorpay_payment_id    String?
  razorpay_signature     String?
  payment_failure_reason String?
  payment_retry_count    Int                 @default(0)
  razorpay_details       Json?
  accepted_at            DateTime?
  prepared_at            DateTime?
  delivered_at           DateTime?
  source                 OrderSource         @default(WEBSITE)
  subtotal_amount        Float               @default(0)
  menu_discount_amount   Float               @default(0)
  coupon_discount_amount Float               @default(0)
  manual_discount_amount Float               @default(0)
  taxable_amount         Float               @default(0)
  gst_rate               Float               @default(0)
  cgst_amount            Float               @default(0)
  sgst_amount            Float               @default(0)
  igst_amount            Float               @default(0)
  tax_amount             Float               @default(0)
  delivery_charge        Float               @default(0)
  packaging_charge       Float               @default(0)
  delivery_distance_km   Float?
  tip_amount             Float               @default(0)
  cancelled_at           DateTime?
  cancellation_reason    String?
  cancelled_by_user_id   Int?
  session_id             Int?
  customer_phone         String?
  kitchen_note           String?
  coupon_usages          coupon_usages[]
  deliveries             deliveries?
  invoices               invoices?
  order_items            order_items[]
  order_status_logs      order_status_logs[]
  user_addresses         user_addresses?     @relation(fields: [address_id], references: [id])
  restaurants            restaurants         @relation(fields: [restaurant_id], references: [id])
  table_sessions         table_sessions?     @relation(fields: [session_id], references: [id])
  restaurant_tables      restaurant_tables?  @relation(fields: [table_id], references: [id])
  users                  User?               @relation(fields: [user_id], references: [id])
  payments               payments[]

  @@index([restaurant_id, created_at])
  @@index([user_id, restaurant_id, created_at])
}

model payments {
  id             Int     @id @default(autoincrement())
  order_id       Int
  user_id        Int?
  transaction_id String?
  amount         Float
  status         String
  method         String
  orders         orders  @relation(fields: [order_id], references: [id])
  users          User?   @relation(fields: [user_id], references: [id])
}

model restaurant_tables {
  id             Int              @id @default(autoincrement())
  restaurant_id  Int
  table_number   String
  qr_code        String?
  status         String?
  capacity       Int              @default(4)
  table_token    String?          @unique
  qr_code_url    String?
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now())
  updated_at     DateTime
  orders         orders[]
  restaurants    restaurants      @relation(fields: [restaurant_id], references: [id])
  table_sessions table_sessions[]

  @@unique([restaurant_id, table_number])
}

model restaurants {
  id                        Int                       @id @default(autoincrement())
  name                      String
  address                   String
  city                      String?
  latitude                  Float
  longitude                 Float
  is_active                 Boolean                   @default(true)
  delivery_radius_km        Float                     @default(8)
  is_location_enabled       Boolean                   @default(true)
  location                  Unsupported("geography")?
  cuisine_type              String?
  description               String?
  image_url                 String?
  created_at                DateTime                  @default(now())
  updated_at                DateTime
  gstin                     String?
  gst_rate                  Float                     @default(5)
  gst_enabled               Boolean                   @default(true)
  gst_mode                  String                    @default("EXCLUSIVE")
  delivery_enabled          Boolean                   @default(true)
  delivery_base_fee         Float                     @default(20)
  delivery_base_distance_km Float                     @default(1)
  delivery_per_km_fee       Float                     @default(7)
  delivery_fee_min          Float?
  delivery_fee_cap          Float?
  free_delivery_min_amount  Float?
  packaging_charge          Float                     @default(0)
  image_public_id           String?
  slug                      String                    @unique
  addon_groups              addon_groups[]
  cart_items                cart_items[]
  categories                Category[]
  coupons                   coupons[]
  delivery_zones            delivery_zones[]
  menu_items                menu_items[]
  orders                    orders[]
  restaurant_tables         restaurant_tables[]
  table_sessions            table_sessions[]
  users                     User[]
}

model role_master {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  user_role user_role[]
}

model social_accounts {
  id               Int      @id @default(autoincrement())
  user_id          Int
  provider         String
  provider_user_id String
  email            String?
  created_at       DateTime @default(now())
  updated_at       DateTime
  users            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
}

model table_sessions {
  id                Int                @id @default(autoincrement())
  restaurant_id     Int
  table_id          Int
  session_token     String             @unique
  status            TableSessionStatus @default(ACTIVE)
  started_at        DateTime           @default(now())
  ended_at          DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime
  orders            orders[]
  restaurants       restaurants        @relation(fields: [restaurant_id], references: [id])
  restaurant_tables restaurant_tables  @relation(fields: [table_id], references: [id])

  @@index([restaurant_id, status])
  @@index([table_id, status])
}

model user_addresses {
  id              Int      @id @default(autoincrement())
  user_id         Int
  address         String
  city            String?
  state           String?
  latitude        Float
  longitude       Float
  is_default      Boolean  @default(false)
  label           String   @default("Home")
  building_floor  String?
  nearby_landmark String?
  orders          orders[]
  users           User     @relation(fields: [user_id], references: [id])
}

model user_role {
  id          Int         @id @default(autoincrement())
  user_id     Int         @unique
  role_id     Int
  role_master role_master @relation(fields: [role_id], references: [id])
  users       User        @relation(fields: [user_id], references: [id])
}

enum OrderSource {
  WEBSITE
  QR_DINE_IN
  ADMIN
  MOBILE_APP
  POS
}

enum TableSessionStatus {
  ACTIVE
  CLOSED
}
