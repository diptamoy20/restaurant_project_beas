# Copy to .env — local development and production configuration for the Inventory ERP backend.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_db?schema=inventory_management"
PORT=4001
NODE_ENV=development

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# API docs (http://localhost:4001/api/docs)
DOCS_ENABLED=true

# Comma-separated list of allowed CORS origins (required in production)
CORS_ORIGINS="http://localhost:4000,http://localhost:4001,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"

# Restaurant Management System base URL (server-to-server integration)
RMS_URL="http://localhost:4000"

