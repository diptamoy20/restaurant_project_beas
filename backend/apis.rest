@baseUrl = http://localhost:4000/api
@token = replace-with-access-token

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "password123"
}

### Checkout quote
POST {{baseUrl}}/checkout/quote
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "restaurantId": 1,
  "addressId": 1,
  "orderType": "DELIVERY",
  "couponCode": "WELCOME50",
  "items": [
    {
      "menuItemId": 1,
      "variantId": 1,
      "quantity": 2
    }
  ]
}

### Create order
POST {{baseUrl}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": 3,
  "restaurantId": 1,
  "addressId": 1,
  "orderType": "DELIVERY",
  "couponCode": "WELCOME50",
  "items": [
    {
      "menuItemId": 1,
      "variantId": 1,
      "quantity": 2
    }
  ]
}

### Create coupon
# Coupon code can repeat across different restaurants.
# Same code is blocked only inside the same restaurant scope.
POST {{baseUrl}}/admin/coupons
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "restaurantId": 1,
  "code": "WELCOME50",
  "description": "Welcome offer",
  "discountType": "PERCENTAGE",
  "discountValue": 10,
  "maxDiscountAmount": 100,
  "minOrderAmount": 299,
  "usageLimitTotal": 500,
  "usageLimitPerUser": 1,
  "isActive": true
}

### List coupons
GET {{baseUrl}}/admin/coupons?status=active&limit=20
Authorization: Bearer {{token}}

### Create same coupon for multiple restaurants
POST {{baseUrl}}/admin/coupons/bulk
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "restaurantIds": [1, 2],
  "code": "WELCOME50",
  "description": "Welcome offer",
  "discountType": "PERCENTAGE",
  "discountValue": 10,
  "maxDiscountAmount": 100,
  "minOrderAmount": 299,
  "usageLimitTotal": 500,
  "usageLimitPerUser": 1,
  "isActive": true
}

### Create Razorpay order
POST {{baseUrl}}/payments/razorpay/order
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderId": 1
}

### QR order
POST {{baseUrl}}/qr/order
Content-Type: application/json

{
  "restaurantId": 1,
  "tableId": 1,
  "items": [
    {
      "menuItemId": 1,
