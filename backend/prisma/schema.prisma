generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderSource {
  WEBSITE
  QR_DINE_IN
  ADMIN
}

model User {
  id                     Int                  @id @default(autoincrement())
  name                   String?
  email                  String?              @unique
  phone                  String?              @unique
  profileImageUrl        String?              @map("profile_image_url")
  profileImagePublicId   String?              @map("profile_image_public_id")
  password               String
  permissions            Json?
  isActive               Boolean              @default(true) @map("is_active")
  refreshToken           String?              @map("refresh_token")
  refreshTokenExpiresAt  DateTime?            @map("refresh_token_expires_at")
  resetPasswordToken     String?              @map("reset_password_token")
  resetPasswordExpiresAt DateTime?            @map("reset_password_expires_at")
  lastLoginAt            DateTime?            @map("last_login_at")
  failedLoginAttempts    Int                  @default(0) @map("failed_login_attempts")
  lockUntil              DateTime?            @map("lock_until")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  role                   UserRole?
  addresses              UserAddress[]
  orders                 Order[]
  cartItems              CartItem[]
  memberships            Membership[]
  loyaltyTxns            LoyaltyTransaction[]
  notifications          Notification[]
  payments               Payment[]
  couponUsages           CouponUsage[]
  socialAccounts         SocialAccount[]
  deliveryAgent          DeliveryAgent?
  deviceTokens           DeviceToken[]

  @@map("users")
}

model SocialAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model RoleMaster {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]

  @@map("role_master")
}

model UserRole {
  id     Int        @id @default(autoincrement())
  userId Int        @unique @map("user_id")
  roleId Int        @map("role_id")
  user   User       @relation(fields: [userId], references: [id])
  role   RoleMaster @relation(fields: [roleId], references: [id])

  @@map("user_role")
}

model UserAddress {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  label     String  @default("Home")
  address   String
  city      String?
  state     String?
  latitude  Float
  longitude Float
  isDefault Boolean @default(false) @map("is_default")
  user      User    @relation(fields: [userId], references: [id])
  orders    Order[]

  @@map("user_addresses")
}

model Restaurant {
  id                     Int                                   @id @default(autoincrement())
  name                   String
  address                String
  city                   String?
  latitude               Float
  longitude              Float
  location               Unsupported("geography(Point,4326)")?
  cuisineType            String?                               @map("cuisine_type")
  description            String?
  imageUrl               String?                               @map("image_url")
  imagePublicId          String?                               @map("image_public_id")
  deliveryRadiusKm       Float                                 @default(8) @map("delivery_radius_km")
  deliveryEnabled        Boolean                               @default(true) @map("delivery_enabled")
  deliveryBaseFee        Float                                 @default(20) @map("delivery_base_fee")
  deliveryBaseDistanceKm Float                                 @default(1) @map("delivery_base_distance_km")
  deliveryPerKmFee       Float                                 @default(7) @map("delivery_per_km_fee")
  deliveryFeeMin         Float?                                @map("delivery_fee_min")
  deliveryFeeCap         Float?                                @map("delivery_fee_cap")
  freeDeliveryMinAmount  Float?                                @map("free_delivery_min_amount")
  packagingCharge        Float                                 @default(0) @map("packaging_charge")
  isLocationEnabled      Boolean                               @default(true) @map("is_location_enabled")
  isActive               Boolean                               @default(true) @map("is_active")
  createdAt              DateTime                              @default(now()) @map("created_at")
  updatedAt              DateTime                              @updatedAt @map("updated_at")
  tables                 RestaurantTable[]
  categories             Category[]
  menuItems              MenuItem[]
  addonGroups            AddonGroup[]
  orders                 Order[]
  deliveryZones          DeliveryZone[]
  coupons                Coupon[]
  gstin                  String?                               @map("gstin")
  gstRate                Float                                 @default(5) @map("gst_rate")
  gstEnabled             Boolean                               @default(true) @map("gst_enabled")
  gstMode                String                                @default("EXCLUSIVE") @map("gst_mode")

  @@map("restaurants")
}

model DeliveryZone {
  id                 Int                                   @id @default(autoincrement())
  restaurantId       Int                                   @map("restaurant_id")
  polygon            Unsupported("geometry(Polygon,4326)")
  minimumOrderAmount Float                                 @default(0) @map("minimum_order_amount")
  deliveryFee        Float                                 @default(0) @map("delivery_fee")
  createdAt          DateTime                              @default(now()) @map("created_at")
  updatedAt          DateTime                              @updatedAt @map("updated_at")
  restaurant         Restaurant                            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("delivery_zones")
}

model RestaurantTable {
  id           Int        @id @default(autoincrement())
  restaurantId Int        @map("restaurant_id")
  tableNumber  String     @map("table_number")
  qrCode       String?    @map("qr_code")
  status       String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  orders       Order[]

  @@map("restaurant_tables")
}

model Category {
  id           Int        @id @default(autoincrement())
  restaurantId Int        @map("restaurant_id")
  name         String
  description  String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]

  @@map("categories")
}

model MenuItem {
  id                  Int               @id @default(autoincrement())
  restaurantId        Int               @map("restaurant_id")
  categoryId          Int               @map("category_id")
  name                String
  description         String?
  price               Float
  discountPrice       Float?            @map("discount_price")
  imageUrl            String?           @map("image_url")
  imagePublicId       String?           @map("image_public_id")
  foodType            String            @default("VEG") @map("food_type")
  spicyLevel          Int?              @map("spicy_level")
  ingredients         String?
  isAvailable         Boolean           @default(true) @map("is_available")
  isBestSelling       Boolean           @default(false) @map("is_best_selling")
  popularityScore     Int               @default(0) @map("popularity_score")
  rating              Float?
  preparationTime     Int?              @map("preparation_time")
  customizableOptions Json?             @map("customizable_options")
  restaurant          Restaurant        @relation(fields: [restaurantId], references: [id])
  category            Category          @relation(fields: [categoryId], references: [id])
  variants            MenuItemVariant[]
  addonGroups         AddonGroup[]
  orderItems          OrderItem[]
  cartItems           CartItem[]

  @@map("menu_items")
}

model MenuItemVariant {
  id         Int         @id @default(autoincrement())
  menuItemId Int         @map("menu_item_id")
  name       String
  price      Float
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("menu_item_variants")
}

model AddonGroup {
  id            Int           @id @default(autoincrement())
  menuItemId    Int           @map("menu_item_id")
  restaurantId  Int           @map("restaurant_id")
  name          String
  selectionType String        @default("MULTI") @map("selection_type")
  isRequired    Boolean       @default(false) @map("is_required")
  minSelect     Int?          @map("min_select")
  maxSelect     Int?          @map("max_select")
  sortOrder     Int           @default(0) @map("sort_order")
  isActive      Boolean       @default(true) @map("is_active")
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options       AddonOption[]

  @@index([restaurantId])
  @@index([menuItemId])
  @@map("addon_groups")
}

model AddonOption {
  id          Int              @id @default(autoincrement())
  groupId     Int              @map("group_id")
  name        String
  price       Float
  isAvailable Boolean          @default(true) @map("is_available")
  sortOrder   Int              @default(0) @map("sort_order")
  group       AddonGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderAddons OrderItemAddon[]

  @@index([groupId])
  @@map("addon_options")
}

model Order {
  id                   Int              @id @default(autoincrement())
  userId               Int?             @map("user_id")
  restaurantId         Int              @map("restaurant_id")
  tableId              Int?             @map("table_id")
  addressId            Int?             @map("address_id")
  orderNumber          String           @unique @map("order_number")
  status               String
  source               OrderSource      @default(WEBSITE)
  orderType            String           @map("order_type")
  totalAmount          Float            @map("total_amount")
  deliveryCharge       Float            @default(0) @map("delivery_charge")
  packagingCharge      Float            @default(0) @map("packaging_charge")
  tipAmount            Float            @default(0) @map("tip_amount")
  deliveryDistanceKm   Float?           @map("delivery_distance_km")
  discountAmount       Float?           @map("discount_amount")
  finalAmount          Float            @map("final_amount")
  subtotalAmount       Float            @default(0) @map("subtotal_amount")
  menuDiscountAmount   Float            @default(0) @map("menu_discount_amount")
  couponDiscountAmount Float            @default(0) @map("coupon_discount_amount")
  manualDiscountAmount Float            @default(0) @map("manual_discount_amount")
  taxableAmount        Float            @default(0) @map("taxable_amount")
  gstRate              Float            @default(0) @map("gst_rate")
  cgstAmount           Float            @default(0) @map("cgst_amount")
  sgstAmount           Float            @default(0) @map("sgst_amount")
  igstAmount           Float            @default(0) @map("igst_amount")
  taxAmount            Float            @default(0) @map("tax_amount")
  paymentStatus        String           @map("payment_status")
  paymentMethod        String?          @map("payment_method")
  razorpayOrderId      String?          @map("razorpay_order_id")
  razorpayPaymentId    String?          @map("razorpay_payment_id")
  razorpaySignature    String?          @map("razorpay_signature")
  paymentFailureReason String?          @map("payment_failure_reason")
  paymentRetryCount    Int              @default(0) @map("payment_retry_count")
  razorpayDetails      Json?            @map("razorpay_details")
  acceptedAt           DateTime?        @map("accepted_at")
  preparedAt           DateTime?        @map("prepared_at")
  deliveredAt          DateTime?        @map("delivered_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  cancellationReason   String?          @map("cancellation_reason")
  cancelledByUserId    Int?             @map("cancelled_by_user_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  user                 User?            @relation(fields: [userId], references: [id])
  restaurant           Restaurant       @relation(fields: [restaurantId], references: [id])
  table                RestaurantTable? @relation(fields: [tableId], references: [id])
  address              UserAddress?     @relation(fields: [addressId], references: [id])
  items                OrderItem[]
  statusLogs           OrderStatusLog[]
  payments             Payment[]
  delivery             Delivery?
  coupons              CouponUsage[]
  invoice              Invoice?

  @@index([userId, restaurantId, createdAt])
  @@index([restaurantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         Int              @id @default(autoincrement())
  orderId    Int              @map("order_id")
  menuItemId Int              @map("menu_item_id")
  variantId  Int?             @map("variant_id")
  quantity   Int
  price      Float
  totalPrice Float            @map("total_price")
  order      Order            @relation(fields: [orderId], references: [id])
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id])
  variant    MenuItemVariant? @relation(fields: [variantId], references: [id])
  addons     OrderItemAddon[]

  @@index([orderId, menuItemId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemAddon {
  id               Int          @id @default(autoincrement())
  orderItemId      Int          @map("order_item_id")
  addonGroupId     Int?         @map("addon_group_id")
  addonOptionId    Int?         @map("addon_option_id")
  addonGroupName   String       @map("addon_group_name")
  addonOptionName  String       @map("addon_option_name")
  addonOptionPrice Float        @map("addon_option_price")
  quantity         Int          @default(1)
  orderItem        OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonOption      AddonOption? @relation(fields: [addonOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([addonOptionId])
  @@map("order_item_addons")
}

model OrderStatusLog {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  status          String
  note            String?
  changedByUserId Int?     @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at")
  order           Order    @relation(fields: [orderId], references: [id])

  @@map("order_status_logs")
}

model Invoice {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique @map("order_id")
  invoiceNumber String    @unique @map("invoice_number")
  status        String    @default("LOCKED")
  issuedAt      DateTime? @map("issued_at")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("invoices")
}

model DeliveryAgent {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique @map("user_id")
  name        String
  phone       String
  isAvailable Boolean    @default(true) @map("is_available")
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries  Delivery[]

  @@index([phone])
  @@map("delivery_agents")
}

model Delivery {
  id           Int                @id @default(autoincrement())
  orderId      Int                @unique @map("order_id")
  agentId      Int?               @map("agent_id")
  status       String
  order        Order              @relation(fields: [orderId], references: [id])
  agent        DeliveryAgent?     @relation(fields: [agentId], references: [id])
  trackingLogs DeliveryTracking[]

  @@map("deliveries")
}

model DeliveryTracking {
  id         Int      @id @default(autoincrement())
  deliveryId Int      @map("delivery_id")
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  recordedAt DateTime @default(now()) @map("recorded_at")
  delivery   Delivery @relation(fields: [deliveryId], references: [id])

  @@map("delivery_tracking")
}

model Payment {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  userId        Int?    @map("user_id")
  transactionId String? @map("transaction_id")
  amount        Float
  status        String
  method        String
  order         Order   @relation(fields: [orderId], references: [id])
  user          User?   @relation(fields: [userId], references: [id])

  @@map("payments")
}

model MembershipTier {
  id          Int          @id @default(autoincrement())
  name        String
  features    String?
  memberships Membership[]

  @@map("membership_tiers")
}

model Membership {
  id     Int            @id @default(autoincrement())
  userId Int            @map("user_id")
  tierId Int            @map("tier_id")
  points Int            @default(0)
  user   User           @relation(fields: [userId], references: [id])
  tier   MembershipTier @relation(fields: [tierId], references: [id])

  @@map("memberships")
}

model LoyaltyTransaction {
  id      Int    @id @default(autoincrement())
  userId  Int    @map("user_id")
  points  Int
  type    String
  orderId Int?   @map("order_id")
  user    User   @relation(fields: [userId], references: [id])

  @@map("loyalty_transactions")
}

model Coupon {
  id                Int           @id @default(autoincrement())
  restaurantId      Int?          @map("restaurant_id")
  code              String
  description       String?
  discountType      String        @map("discount_type")
  discountValue     Float         @map("discount_value")
  maxDiscountAmount Float?        @map("max_discount_amount")
  minOrderAmount    Float?        @map("min_order_amount")
  startsAt          DateTime?     @map("starts_at")
  expiresAt         DateTime?     @map("expiry_date")
  usageLimitTotal   Int?          @map("usage_limit_total")
  usageLimitPerUser Int?          @map("usage_limit_per_user")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  restaurant        Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usages            CouponUsage[]

  @@index([restaurantId])
  @@index([code, restaurantId])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  userId         Int      @map("user_id")
  orderId        Int      @map("order_id")
  discountAmount Float    @default(0) @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model CartItem {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  menuItemId Int              @map("menu_item_id")
  variantId  Int?             @map("variant_id")
  quantity   Int
  price      Float
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant    MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, menuItemId, variantId])
  @@map("cart_items")
}

model Notification {
  id      Int     @id @default(autoincrement())
  userId  Int     @map("user_id")
  title   String
  message String
  isRead  Boolean @default(false) @map("is_read")
  user    User    @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  token      String   @unique
  platform   String?
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
